<?xml version="1.0" encoding="utf-8"?>
<!-- blocking update gate card: version chips, release notes with sections,
     live download progress and a proper install/retry flow.
     palette matches the launcher (bg #14171E, surface #2A303B, accent #FFC25E) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#14171E"
        android:padding="24dp">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM UPDATE"
                android:textColor="#FFC25E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CS16Client"
                android:textColor="#E8ECF4"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <TextView
                        android:id="@+id/upd_from"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#2A303B"
                        android:textColor="#AEB7C6"
                        android:textSize="12sp"
                        android:fontFamily="monospace"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="&#8195;&#8594;&#8195;"
                        android:textColor="#7E8CA0"
                        android:textSize="12sp"
                        android:layout_gravity="center_vertical" />

                <TextView
                        android:id="@+id/upd_to"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#FFC25E"
                        android:textColor="#14171E"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp" />
        </LinearLayout>

        <TextView
                android:id="@+id/upd_release"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8ECF4"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

        <TextView
                android:id="@+id/upd_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#7E8CA0"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

        <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2A303B"
                android:layout_marginTop="12dp" />

        <ScrollView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="10dp"
                android:fadeScrollbars="true"
                android:scrollbars="vertical">

                <TextView
                        android:id="@+id/upd_changelog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#AEB7C6"
                        android:textSize="12.5sp"
                        android:lineSpacingExtra="3dp" />
        </ScrollView>

        <ProgressBar
                android:id="@+id/upd_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                android:indeterminate="false"
                android:progressTint="#FFC25E"
                android:progressBackgroundTint="#2A303B" />

        <TextView
                android:id="@+id/upd_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#7E8CA0"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:visibility="gone" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="18dp">

                <TextView
                        android:id="@+id/upd_secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#2A303B"
                        android:textColor="#AEB7C6"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />

                <TextView
                        android:id="@+id/upd_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="#FFC25E"
                        android:textColor="#14171E"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginLeft="10dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp" />
        </LinearLayout>
</LinearLayout>
