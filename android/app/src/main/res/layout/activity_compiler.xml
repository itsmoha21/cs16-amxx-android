<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/menu_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="@string/compiler_title_big"
                android:textColor="#E8ECF4"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/compiler_sub"
                android:textColor="#7E8CA0"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:letterSpacing="0.14"
                android:text="@string/compiler_section_scripts"
                android:textColor="#7E8CA0"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_dark"
                android:orientation="vertical"
                android:padding="8dp">

                <ListView
                    android:id="@+id/compiler_scripts"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:choiceMode="multipleChoice"
                    android:divider="#00000000"
                    android:dividerHeight="5dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/compiler_selected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:textColor="#B8A8E8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/compiler_go"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_gold"
                android:fontFamily="sans-serif-medium"
                android:text="@string/compiler_compile_sel"
                android:textColor="#2A0F0C"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/compiler_go_all"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_dark"
                android:fontFamily="sans-serif-medium"
                android:text="@string/compiler_compile_all"
                android:textColor="#C9CFDB"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:letterSpacing="0.14"
                    android:text="@string/compiler_log_header"
                    android:textColor="#7E8CA0"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/compiler_copy"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginRight="7dp"
                    android:background="@drawable/btn_dark"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="66dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="@string/compiler_copy"
                    android:textColor="#C9CFDB"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/compiler_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/btn_dark"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="66dp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:text="@string/compiler_clear"
                    android:textColor="#C9CFDB"
                    android:textSize="12sp" />

            </LinearLayout>

            <ScrollView
                android:id="@+id/compiler_log_scroll"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/log_bg"
                android:padding="12dp">

                <TextView
                    android:id="@+id/compiler_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#A8E6B8"
                    android:textSize="11sp"
                    android:typeface="monospace" />

            </ScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- bottom tabs (shared with launcher/plugins) -->
    <include layout="@layout/tab_bar" />
</LinearLayout>
