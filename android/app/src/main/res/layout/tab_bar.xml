<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#14171E"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/tab_launch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/row_pressed"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tab_launch_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingTop="7dp"
            android:paddingRight="20dp"
            android:paddingBottom="7dp"
            android:src="@drawable/ic_play_gray" />

        <TextView
            android:id="@+id/tab_launch_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/tab_launch"
            android:textColor="#7E8CA0"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_plugins"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/row_pressed"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tab_plugins_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingTop="7dp"
            android:paddingRight="20dp"
            android:paddingBottom="7dp"
            android:src="@drawable/ic_list_gray" />

        <TextView
            android:id="@+id/tab_plugins_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/tab_plugins"
            android:textColor="#7E8CA0"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_compile"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/row_pressed"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/tab_compile_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingLeft="20dp"
            android:paddingTop="7dp"
            android:paddingRight="20dp"
            android:paddingBottom="7dp"
            android:src="@drawable/ic_code_gray" />

        <TextView
            android:id="@+id/tab_compile_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/tab_compile"
            android:textColor="#7E8CA0"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
